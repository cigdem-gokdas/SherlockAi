# auto: önce Ollama, ulaşılamazsa Gemini, o da yoksa çevrimdışı vaka.
# Diğer değerler: ollama, gemini, offline
AI_PROVIDER=auto

# 8 GB Apple Silicon için hızlı yerel model
SHERLOCK_MODEL=qwen3:1.7b

# Ollama farklı bir adreste çalışıyorsa değiştirin.
OLLAMA_HOST=http://127.0.0.1:11434

# Vaka üretimi için azami bekleme süresi (saniye)
OLLAMA_TIMEOUT=180

# Ollama kullanmayacaksanız anahtarı yalnızca yerel .env dosyanıza yazın.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
